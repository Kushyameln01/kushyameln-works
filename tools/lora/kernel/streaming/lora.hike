package main

// Raw products retain +0 initialization and separate F32 multiply/add in ascending rank order.
cfunc LoraProduct4(down *float32, up *float32, out *float32, rows int32, cols int32, rank int32) int32 {
    if rows < 1 || cols < 1 || rank < 1 { return -1 }
    var i int32 = 0
    var j int32 = 0
    var k int32 = 0
    var d int32 = 0
    var at int32 = 0
    var u float32 = 0
    var sum float32 = 0
    var s0 float32 = 0
    var s1 float32 = 0
    var s2 float32 = 0
    var s3 float32 = 0
    for i = 0; i < rows; i = i + 1 {
        j = 0
        for j + 4 <= cols {
            s0 = 0
            s1 = 0
            s2 = 0
            s3 = 0
            for k = 0; k < rank; k = k + 1 {
                u = up[i * rank + k]
                d = k * cols + j
                s0 = s0 + u * down[d + 0]
                s1 = s1 + u * down[d + 1]
                s2 = s2 + u * down[d + 2]
                s3 = s3 + u * down[d + 3]
            }
            at = i * cols + j
            out[at + 0] = s0
            out[at + 1] = s1
            out[at + 2] = s2
            out[at + 3] = s3
            j = j + 4
        }
        for j < cols {
            sum = 0
            for k = 0; k < rank; k = k + 1 { sum = sum + up[i * rank + k] * down[k * cols + j] }
            out[i * cols + j] = sum
            j = j + 1
        }
    }
    return 0
}
