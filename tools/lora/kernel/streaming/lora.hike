cfunc LoraAdd(base *float32, delta *float32, out *float32, n int32, scale float32) int32 {
    if n < 0 { return -1 }
    for i := int32(0); i < n; i = i + 1 { out[i] = base[i] + scale * delta[i] }
    return 0
}
cfunc LoraCopy(input *float32, out *float32, n int32) int32 {
    if n < 0 { return -1 }
    for i := int32(0); i < n; i = i + 1 { out[i] = input[i] }
    return 0
}
// mode 1 = BF16, mode 2 = IEEE binary16. Reject infinities and NaNs.
cfunc LoraDecode(input *int32, out *float32, n int32, mode int32) int32 {
    if n < 0 || mode < 1 || mode > 2 { return -1 }
    var i int32 = 0
    var bits int32 = 0
    var divisor int32 = 128
    var maxExp int32 = 255
    var bias int32 = 127
    var exponent int32 = 0
    var fraction int32 = 0
    var value float32 = 0
    var power int32 = 0
    for i = 0; i < n; i = i + 1 {
        bits = input[i]
        divisor = 128
        maxExp = 255
        bias = 127
        if mode == 2 { divisor = 1024; maxExp = 31; bias = 15 }
        exponent = (bits / divisor) % (maxExp + 1)
        fraction = bits % divisor
        if exponent == maxExp { return -2 }
        value = float32(fraction) / float32(divisor)
        power = exponent - bias
        if exponent == 0 { power = 1 - bias } else { value = value + 1 }
        for power < 0 { value = value * 0.5; power = power + 1 }
        for power > 0 { value = value * 2; power = power - 1 }
        if bits >= 32768 { value = -value }
        out[i] = value
    }
    return 0
}
// Validate every F32 value without an early-exit branch in the scan. Ordered
// bounds reject NaNs as well as infinities and retain signed zero/subnormals.
// The host bounds n by its fixed arena, so the invalid-value count cannot wrap.
cfunc LoraFinite(input *float32, n int32) int32 {
    if n < 0 { return -1 }
    var i int32 = 0
    var bad int32 = 0
    var value float32 = 0
    var max float32 = 340282346638528859811704183484516925440.0
    for i = 0; i < n; i = i + 1 {
        value = input[i]
        if value <= max && value >= -max { } else { bad = bad + 1 }
    }
    return bad
}
func main() int { return 0 }
