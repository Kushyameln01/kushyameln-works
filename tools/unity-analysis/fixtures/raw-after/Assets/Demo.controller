%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!91 &9100000
AnimatorController:
  m_Name: Demo
  m_AnimatorParameters:
  - m_Name: Speed
    m_Type: 1
    m_DefaultFloat: 0
    m_DefaultInt: 0
    m_DefaultBool: 0
  m_AnimatorLayers:
  - m_Name: Base
    m_StateMachine: {fileID: 11070000}
  m_Invalid: {fileID: 999}
  m_Unprovided: {fileID: 7400000, guid: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee, type: 2}
