package main

// Pointers refer to caller-owned, disjoint, range-checked i32 arenas.
// Validate every value before the first output write; no allocation or imports.
cfunc UaIncoming(targets *int, edgeCount int, nodeCount int, out *int, outCapacity int) int {
    if edgeCount < 0 || edgeCount > 262144 || nodeCount < 0 || nodeCount > 262144 || outCapacity < nodeCount || outCapacity > 262144 { return -1 }
    for i := 0; i < edgeCount; i = i + 1 {
        if targets[i] < 0 || targets[i] >= nodeCount { return -2 }
    }
    for i := 0; i < nodeCount; i = i + 1 { out[i] = 0 }
    for i := 0; i < edgeCount; i = i + 1 { out[targets[i]] = out[targets[i]] + 1 }
    return 0
}

cfunc UaTypeCheck(actual *int, allowedMasks *int, count int, out *int, outCapacity int) int {
    if count < 0 || count > 262144 || outCapacity < count || outCapacity > 262144 { return -1 }
    for i := 0; i < count; i = i + 1 {
        if actual[i] < 0 || actual[i] > 4 || allowedMasks[i] < 0 || allowedMasks[i] > 31 { return -2 }
    }
    for i := 0; i < count; i = i + 1 {
        if actual[i] == 0 || allowedMasks[i] == 0 {
            out[i] = 0
        } else {
            if (allowedMasks[i] & (1 << actual[i])) != 0 { out[i] = 1 } else { out[i] = 2 }
        }
    }
    return 0
}

cfunc UaDiff(before *int, after *int, count int, out *int, outCapacity int) int {
    if count < 0 || count > 262144 || outCapacity < count || outCapacity > 262144 { return -1 }
    for i := 0; i < count; i = i + 1 {
        if before[i] < 0 || after[i] < 0 { return -2 }
    }
    for i := 0; i < count; i = i + 1 {
        if before[i] == after[i] { out[i] = 0 } else { out[i] = 1 }
    }
    return 0
}
