package main

// The host owns validated disjoint i32 arenas. No allocator or host imports.
cfunc KiStep(records *int, n int, state *int, finalFlag int, out *int, capacity int, meta *int) int {
    if n < 0 || n > 65536 || capacity < 1 || capacity > 65536 || finalFlag < 0 || finalFlag > 1 { return -1 }
    active := state[0]
    term := state[1]
    doc := state[2]
    field := state[3]
    count := state[4]
    if active < 0 || active > 1 || term < 0 || doc < 0 || field < 0 || count < 0 { return -1 }
    if active == 1 && count == 0 { return -1 }
    if active == 0 && count != 0 { return -1 }
    validation := ValidateRecords(records, n, state)
    if validation != 0 { return validation }
    consumed := 0
    emitted := 0
    stopped := 0
    nt := 0
    nd := 0
    nf := 0
    for consumed < n && stopped == 0 {
        nt = records[consumed * 3]
        nd = records[consumed * 3 + 1]
        nf = records[consumed * 3 + 2]
        if active == 1 && (nt != term || nd != doc || nf != field) {
            if emitted == capacity { stopped = 1 } else {
                out[emitted * 4] = term
                out[emitted * 4 + 1] = doc
                out[emitted * 4 + 2] = field
                out[emitted * 4 + 3] = count
                emitted = emitted + 1
                active = 0
            }
        }
        if stopped == 0 {
            if active == 0 {
                term = nt
                doc = nd
                field = nf
                count = 0
                active = 1
            }
            count = count + 1
            consumed = consumed + 1
        }
    }
    if finalFlag == 1 && consumed == n && active == 1 {
        if emitted == capacity { stopped = 1 } else {
            out[emitted * 4] = term
            out[emitted * 4 + 1] = doc
            out[emitted * 4 + 2] = field
            out[emitted * 4 + 3] = count
            emitted = emitted + 1
            active = 0
            count = 0
        }
    }
    state[0] = active
    state[1] = term
    state[2] = doc
    state[3] = field
    state[4] = count
    meta[0] = consumed
    meta[1] = emitted
    meta[2] = 0
    if finalFlag == 1 && consumed == n && active == 0 { meta[2] = 1 }
    meta[3] = stopped
    return 0
}

func ValidateRecords(records *int, n int, state *int) int {
    // Validate the complete input before changing state or output.
    a := state[0]
    t := state[1]
    d := state[2]
    f := state[3]
    c := state[4]
    nt := 0
    nd := 0
    nf := 0
    for i := 0; i < n; i = i + 1 {
        nt = records[i * 3]
        nd = records[i * 3 + 1]
        nf = records[i * 3 + 2]
        if nt < 0 || nd < 0 || nf < 0 { return -1 }
        if a == 1 {
            if nd < d || (nd == d && nt < t) || (nd == d && nt == t && nf < f) { return -2 }
            if nd == d && nt == t && nf == f {
                if c == 2147483647 { return -3 }
                c = c + 1
            } else { c = 1 }
        } else { c = 1 }
        a = 1
        t = nt
        d = nd
        f = nf
    }
    return 0
}

func main() int { return 0 }
