package main

// The host supplies disjoint range-checked arenas in this Instance's Memory.
// No per-iteration declarations: the fixed compiler otherwise bumps scratch.
func DecodeE4M3(code int) float32 {
    exponent := (code >> 3) & 15
    mantissa := code & 7
    value := float32(0)
    power := float32(1)
    shift := exponent - 7
    if exponent == 0 {
        value = float32(mantissa) * float32(0.001953125)
    } else {
        for shift > 0 { power = power * float32(2); shift = shift - 1 }
        for shift < 0 { power = power * float32(0.5); shift = shift + 1 }
        value = (float32(1) + float32(mantissa) * float32(0.125)) * power
    }
    if (code & 128) != 0 { value = value * float32(-1) }
    return value
}

func IsFinite(value float32) bool {
    return value == value && value - value == float32(0)
}

cfunc DequantScale(q *byte, count int, scale float32, out *float32, capacity int) int {
    if count < 1 || count > 81920 || capacity < count || capacity > 81920 { return -1 }
    if !IsFinite(scale) || scale <= float32(0) { return -2 }
    i := 0
    code := 0
    value := float32(0)
    for i < count {
        code = int(q[i])
        if (code & 127) == 127 { return -2 }
        i = i + 1
    }
    i = 0
    for i < count {
        value = DecodeE4M3(int(q[i])) * scale
        if !IsFinite(value) { return -3 }
        out[i] = value
        i = i + 1
    }
    return 0
}

cfunc AddBias(y *float32, bias *float32, count int, out *float32, capacity int) int {
    if count < 1 || count > 16 || capacity < count || capacity > 16 { return -1 }
    i := 0
    value := float32(0)
    for i < count {
        if !IsFinite(y[i]) || !IsFinite(bias[i]) { return -2 }
        i = i + 1
    }
    i = 0
    for i < count {
        value = y[i] + bias[i]
        if !IsFinite(value) { return -3 }
        out[i] = value
        i = i + 1
    }
    return 0
}

func main() int { return 0 }
