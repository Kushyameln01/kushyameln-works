{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kushyameln:works-artifact-package:1.0-draft.1",
  "title": "Works Artifact Package Manifest",
  "description": "Persisted complete manifest. Writer may accept a seed without byteLength/sha256 and computes those from actual bytes. Paths, unique identities, file kinds, required bindings and semantic sidecars have additional procedural validation in package.mjs.",
  "type": "object",
  "required": [
    "packageVersion",
    "packageId",
    "artifacts",
    "files",
    "extensions",
    "payloadBindings"
  ],
  "properties": {
    "packageVersion": {
      "const": "works-artifact-package/1.0-draft.1"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^:]+:.+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "schemaId",
          "schemaVersion",
          "requiredForUse",
          "data"
        ],
        "properties": {
          "schemaId": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "type": "string",
            "minLength": 1
          },
          "requiredForUse": {
            "type": "boolean"
          },
          "data": {}
        },
        "additionalProperties": true
      }
    },
    "payloadBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payloadBinding"
      }
    },
    "binaryBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binaryBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "nativePath",
        "descriptorPath",
        "evidencePath",
        "tracePath",
        "snapshotPath",
        "extensionsPath",
        "codec"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "nativePath": {
          "type": "string",
          "minLength": 1
        },
        "descriptorPath": {
          "type": "string",
          "minLength": 1
        },
        "evidencePath": {
          "type": "string",
          "minLength": 1
        },
        "tracePath": {
          "type": "string",
          "minLength": 1
        },
        "snapshotPath": {
          "type": "string",
          "minLength": 1
        },
        "extensionsPath": {
          "type": "string",
          "minLength": 1
        },
        "codec": {
          "type": "object",
          "required": [
            "codecId",
            "codecVersion",
            "sourceRef"
          ],
          "properties": {
            "codecId": {
              "type": "string",
              "minLength": 1
            },
            "codecVersion": {
              "type": "string",
              "minLength": 1
            },
            "sourceRef": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "repository",
                    "commit",
                    "path"
                  ],
                  "properties": {
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "required": [
                    "archiveRef",
                    "sha256"
                  ],
                  "properties": {
                    "archiveRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "required",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "native",
            "descriptor",
            "evidence",
            "trace",
            "snapshot",
            "extensions",
            "attachment"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "payloadBinding": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "nativePath": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "decoded-tensor-data"
        }
      },
      "required": [
        "ref",
        "artifactId",
        "nativePath",
        "kind"
      ],
      "additionalProperties": false
    },
    "binaryBinding": {
      "type": "object",
      "properties": {
        "binaryRef": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Uint8Array",
            "Uint8ClampedArray",
            "Int8Array",
            "Uint16Array",
            "Int16Array",
            "Uint32Array",
            "Int32Array",
            "Float32Array",
            "Float64Array",
            "BigInt64Array",
            "BigUint64Array",
            "ArrayBuffer",
            "DataView"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "binaryRef",
        "path",
        "type",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "evidenceSidecar": {
      "type": "object",
      "required": [
        "schemaVersion",
        "artifactId",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidenceId": {
                "type": "string",
                "minLength": 1
              },
              "data": {}
            },
            "required": [
              "evidenceId",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "absentReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "traceSidecar": {
      "type": "object",
      "required": [
        "schemaVersion",
        "artifactId",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "traceId": {
                "type": "string",
                "minLength": 1
              },
              "data": {}
            },
            "required": [
              "traceId",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "absentReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
