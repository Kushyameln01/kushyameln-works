  "notManagerResponsibilities": [
    "derive-model-formulas",
    "choose-new-tolerances",
    "normalize-tensors",
    "reimplement-low-rank-or-FP8-math",
    "infer-undeclared-profile-from-shape-or-filename",
    "promote-evidence-scope"
  ],
  "changePolicy": {
    "numericalOwner": "proposes rule/source/profile/reference/gate",
    "normMaintainer": "publishes versioned conditions derived from reviewed rule",
    "manager": "compares against a pinned published norm",
    "missingNorm": "If required contract/semantic identity is unknown, compatibility UNVERIFIED on dependent edge. If only numerical gate/acceptance receipt is missing, retain contract-based compatibility and set validation NOT_VERIFIED/readiness BLOCKED; no inferred fallback."
  },
