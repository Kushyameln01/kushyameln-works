  "status": "documented-draft",
  "runtimeIntegrated": false,
  "fieldNamespace": "catalog/manager-adapter declaration vocabulary; native APIs remain unchanged",
  "classification": {
    "compatibility": [
      "COMPATIBLE",
      "NEEDS_ADAPTER",
      "INCOMPATIBLE",
      "UNVERIFIED"
    ],
    "validation": [
      "PASS",
      "FAIL",
      "NOT_VERIFIED"
    ],
    "readiness": [
      "READY",
      "BLOCKED",
      "FAILED"
    ],
    "unknownDefaults": {
      "missingRequiredContractOrIdentity": "UNVERIFIED",
      "knownConflict": "INCOMPATIBLE",
      "identifiedRequiredAdapterNotExecuted": "NEEDS_ADAPTER",
      "requiredTransformNotIdentified": "UNVERIFIED",
      "missingNumericalAcceptanceEvidence": {
        "compatibility": "retain contract-based result",
        "validation": "NOT_VERIFIED",
        "readiness": "BLOCKED"
      }
    }
  },
